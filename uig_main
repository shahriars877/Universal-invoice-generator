/* =========================================================
   SAVE / LOAD
   ========================================================= */
function saveInvoice(){
  const inv = readDraft();
  if (!inv.customer.name && inv.items.length === 0){
    toast('Add a customer name or at least one item first.');
    return;
  }
  if (currentId){
    const i = db.invoices.findIndex(x => x.id === currentId);
    if (i > -1) db.invoices[i] = { ...inv, id: currentId, createdAt: db.invoices[i].createdAt };
  } else {
    inv.id = uid();
    inv.createdAt = new Date().toISOString();
    db.invoices.push(inv);
    currentId = inv.id;
    db.settings.nextNo = (db.settings.nextNo || 1) + 1;
  }
  persist();
  renderHistory();
  renderSettingsForm();
  toast('Invoice saved ✓');
}

function loadIntoForm(inv, asNew = false){
  currentId = asNew ? null : inv.id;
  document.getElementById('invNo').value   = asNew ? nextInvoiceNo() : inv.no;
  document.getElementById('invDate').value = asNew ? todayISO() : inv.date;
  document.getElementById('poNo').value    = asNew ? nextPONo() : (inv.poNo || '');
  document.getElementById('cName').value    = inv.customer?.name || '';
  document.getElementById('cAddress').value = inv.customer?.address || '';
  document.getElementById('cMobile').value  = inv.customer?.mobile || '';
  document.getElementById('remarks').value  = inv.remarks || '';

  document.getElementById('discountType').value = inv.discountType || 'flat';
  document.getElementById('discountValue').value = inv.discountValue || 0;

  document.getElementById('items').innerHTML = '';
  (inv.items?.length ? inv.items : [{}]).forEach(it => addItemRow(it));

  switchView('new');
  recalc();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function newBlank(){
  currentId = null;
  document.getElementById('invNo').value   = nextInvoiceNo();
  document.getElementById('invDate').value = todayISO();
  document.getElementById('poNo').value    = nextPONo();
  ['cName','cAddress','cMobile','remarks'].forEach(id => document.getElementById(id).value = '');
  
  document.getElementById('discountType').value = 'flat';
  document.getElementById('discountValue').value = 0;
  
  document.getElementById('items').innerHTML = '';
  addItemRow();
  recalc();
}

