/* =========================================================
   VIEW SWITCH
   ========================================================= */
function switchView(name){
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('view-' + name).classList.add('active');
  document.querySelectorAll('.tab').forEach(t =>
    t.classList.toggle('active', t.dataset.view === name));
  if (name === 'history') renderHistory();
  if (name === 'products') renderProducts();
  if (name === 'settings') renderSettingsForm();
}

function toast(msg){
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toast._t);
  toast._t = setTimeout(() => el.classList.remove('show'), 2200);
}

/* =========================================================
   LOGO HELPERS
   ========================================================= */
function handleLogoUpload(file, key, maxKB = 500){
  if (!file) return;
  if (file.size > maxKB * 1024){
    toast(`Logo too large — keep it under ${maxKB} KB`);
    return;
  }
  const reader = new FileReader();
  reader.onload = ev => {
    db.settings[key] = ev.target.result;
    persist();
    renderLogoPreviews();
    recalc();
    toast('Logo updated');
  };
  reader.readAsDataURL(file);
}

/* =========================================================
   BOOT
   ========================================================= */
function init(){
  /* tabs */
  document.getElementById('tabs').addEventListener('click', e => {
    const btn = e.target.closest('.tab');
    if (btn) switchView(btn.dataset.view);
  });

  /* start blank */
  newBlank();

  /* live recalc */
  document.querySelector('.form-panel').addEventListener('input', recalc);
  document.querySelector('.form-panel').addEventListener('change', recalc);

  /* product code lookup */
  document.getElementById('items').addEventListener('input', e => {
    const row = e.target.closest('.item-row');
    if (!row) return;
    if (e.target.classList.contains('i-code')){
      const code = e.target.value.trim().toLowerCase();
      const p = db.products.find(x => x.code.toLowerCase() === code);
      if (p){
        row.querySelector('.i-name').value = p.name;
        const priceEl = row.querySelector('.i-price');
        if (!Number(priceEl.value)) priceEl.value = p.price || 0;
      }
    }
    recalc();
  });

  document.getElementById('btnAddItem').addEventListener('click', () => addItemRow());
  document.getElementById('btnSave').addEventListener('click', saveInvoice);
  document.getElementById('btnPrint').addEventListener('click', () => { recalc(); window.print(); });
  document.getElementById('btnNew').addEventListener('click', newBlank);

  /* history actions */
  document.getElementById('historyBody').addEventListener('click', e => {
    const btn = e.target.closest('button[data-act]');
    if (!btn) return;
    const inv = db.invoices.find(x => x.id === btn.dataset.id);
    if (!inv) return;

    if (btn.dataset.act === 'view')  loadIntoForm(inv, false);
    if (btn.dataset.act === 'dup')   loadIntoForm(inv, true);
    if (btn.dataset.act === 'print'){
      loadIntoForm(inv, false);
      setTimeout(() => window.print(), 120);
    }
    if (btn.dataset.act === 'del'){
      if (confirm('Delete invoice ' + inv.no + '?')){
        db.invoices = db.invoices.filter(x => x.id !== inv.id);
        if (currentId === inv.id) newBlank();
        persist(); renderHistory(); toast('Invoice deleted');
      }
    }
  });

  /* products */
  document.getElementById('prodSearch').addEventListener('input', renderProducts);

  document.getElementById('btnAddProduct').addEventListener('click', () => {
    const name = document.getElementById('npName').value.trim();
    const cat  = document.getElementById('npCat').value.trim() || 'General';
    const unit = document.getElementById('npUnit').value.trim() || 'pcs';
    const price= Number(document.getElementById('npPrice').value) || 0;
    if (!name){ toast('Product name is required'); return; }
    const code = nextProductCode(cat, db.products);
    db.products.push({ code, name, category: cat, unit, price });
    persist(); renderProducts();
    ['npName','npCat'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('npUnit').value = 'pcs';
    document.getElementById('npPrice').value = 0;
    toast('Added ' + code);
  });

  document.getElementById('btnBulk').addEventListener('click', () => {
    const raw = document.getElementById('bulkText').value.trim();
    if (!raw){ toast('Paste some rows first'); return; }
    let added = 0;
    raw.split(/\r?\n/).forEach(line => {
      if (!line.trim()) return;
      const sep = line.includes('|') ? '|' : (line.includes('\t') ? '\t' : ',');
      const parts = line.split(sep).map(s => s.trim());
      const [name, cat, price, unit] = parts;
      if (!name) return;
      const category = cat || 'General';
      db.products.push({
        code: nextProductCode(category, db.products),
        name, category, unit: unit || 'pcs', price: Number(price) || 0
      });
      added++;
    });
    persist(); renderProducts();
    document.getElementById('bulkText').value = '';
    toast(added + ' product(s) imported');
  });

  document.getElementById('btnClearProducts').addEventListener('click', () => {
    if (confirm('Remove all products? Saved invoices are not affected.')){
      db.products = []; persist(); renderProducts(); toast('Products cleared');
    }
  });

  document.getElementById('productsBody').addEventListener('click', e => {
    const addBtn = e.target.closest('button[data-add]');
    if (addBtn){
      const p = db.products.find(x => x.code === addBtn.dataset.add);
      if (!p) return;
      if (!document.getElementById('view-new').classList.contains('active')) switchView('new');
      addItemRow({ code: p.code, name: p.name, qty: 1, price: p.price || 0 });
      toast(p.code + ' added to invoice');
      return;
    }
    const delBtn = e.target.closest('button[data-del]');
    if (delBtn){
      if (!confirm('Delete product ' + delBtn.dataset.del + '?')) return;
      db.products = db.products.filter(p => p.code !== delBtn.dataset.del);
      persist(); renderProducts(); toast('Product deleted');
    }
  });

  /* ---- logo uploads ---- */
  document.getElementById('logo1File').addEventListener('change', e =>
    handleLogoUpload(e.target.files[0], 'logo1'));
  document.getElementById('logo2File').addEventListener('change', e =>
    handleLogoUpload(e.target.files[0], 'logo2'));
  
  // Footer Logo Upload
  document.getElementById('logoFooterFile').addEventListener('change', e =>
    handleLogoUpload(e.target.files[0], 'logoFooter'));

  document.getElementById('btnRemoveLogo1').addEventListener('click', () => {
    db.settings.logo1 = ''; persist(); renderLogoPreviews(); recalc();
    document.getElementById('logo1File').value = '';
    toast('Left logo removed');
  });
  document.getElementById('btnRemoveLogo2').addEventListener('click', () => {
    db.settings.logo2 = ''; persist(); renderLogoPreviews(); recalc();
    document.getElementById('logo2File').value = '';
    toast('Right logo removed');
  });
  
  // Footer Logo Remove
  document.getElementById('btnRemoveLogoFooter').addEventListener('click', () => {
    db.settings.logoFooter = ''; persist(); renderLogoPreviews(); recalc();
    document.getElementById('logoFooterFile').value = '';
    toast('Footer logos removed');
  });

  /* settings save */
  document.getElementById('btnSaveSettings').addEventListener('click', () => {
    const s = db.settings;
    s.name    = document.getElementById('sName').value.trim() || 'Your Company';
    s.address = document.getElementById('sAddress').value.trim();
    s.email   = document.getElementById('sEmail').value.trim();
    s.phone   = document.getElementById('sPhone').value.trim();
    s.web     = document.getElementById('sWeb').value.trim();
    s.from    = document.getElementById('sFrom').value.trim();
    s.fromAddr= document.getElementById('sFromAddr').value.trim();
    s.seller  = document.getElementById('sSeller').value.trim();
    s.sellerPhone = document.getElementById('sSellerPhone').value.trim();
    s.terms   = document.getElementById('sTerms').value;
    s.prefix  = document.getElementById('sPrefix').value.trim() || 'INV';
    s.nextNo  = Math.max(1, Number(document.getElementById('sNextNo').value) || 1);
    s.poPrefix= document.getElementById('sPoPrefix').value.trim() || 'DRIS/PO';
    persist();
    if (!currentId){
      document.getElementById('invNo').value = nextInvoiceNo();
      document.getElementById('poNo').value  = nextPONo();
    }
    recalc();
    toast('Settings saved ✓');
  });

  document.getElementById('btnResetStock').addEventListener('click', () => {
    if (!confirm('Replace the product list with the default 27-item robotics stock list? Invoices are kept.')) return;
    db.products = buildSeedProducts();
    persist(); renderProducts(); toast('Stock list restored');
  });

  /* backup */
  document.getElementById('btnExport').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(db, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'daffodil-invoices-' + todayISO() + '.json';
    a.click();
    URL.revokeObjectURL(a.href);
  });
  document.getElementById('btnImport').addEventListener('click', () =>
    document.getElementById('importFile').click());
  document.getElementById('importFile').addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      try {
        const data = JSON.parse(ev.target.result);
        if (!data.settings || !Array.isArray(data.products) || !Array.isArray(data.invoices))
          throw new Error('Invalid backup file');
        if (!confirm('Replace all current data with this backup?')) return;
        db = data; persist();
        renderProducts(); renderHistory(); renderSettingsForm();
        newBlank(); toast('Backup restored ✓');
      } catch (err){ toast('Import failed: ' + err.message); }
    };
    reader.readAsText(file);
  });

  /* boot render */
  refreshProductDatalist();
  renderProducts();
  renderHistory();
  renderSettingsForm();
  recalc();
}

document.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
