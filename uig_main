/* ---------- numbering ---------- */
function nextInvoiceNo(){
  return (db.settings.prefix || 'INV') + '-' + String(db.settings.nextNo || 1).padStart(4, '0');
}
function nextPONo(){
  const year = new Date().getFullYear();
  const prefix = (db.settings.poPrefix || 'DRIS/PO').replace(/\/+$/, '');
  let max = 0;
  db.invoices.forEach(inv => {
    const m = (inv.poNo || '').match(new RegExp('^' + prefix.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '/(\\d{4})/(\\d+)'));
    if (m && Number(m[1]) === year) max = Math.max(max, Number(m[2]));
  });
  return prefix + '/' + year + '/' + String(max + 1).padStart(3, '0');
}
function nextProductCode(category, list){
  const p = categoryPrefix(category);
  let max = 0;
  list.forEach(x => {
    if (x.code && x.code.startsWith(p + '-')){
      const n = parseInt(x.code.slice(p.length + 1), 10);
      if (n > max) max = n;
    }
  });
  return p + '-' + String(max + 1).padStart(3, '0');
}

/* =========================================================
   DRAFT READ
   ========================================================= */
function readDraft(){
  const items = [...document.querySelectorAll('#items .item-row')].map(row => ({
    code:  row.querySelector('.i-code').value.trim(),
    name:  row.querySelector('.i-name').value.trim(),
    qty:   Number(row.querySelector('.i-qty').value) || 0,
    price: Number(row.querySelector('.i-price').value) || 0
  })).filter(it => it.code || it.name || it.qty || it.price);

  const subtotal = items.reduce((s, it) => s + it.qty * it.price, 0);

  const dType = document.getElementById('discountType').value;
  const dValue = Number(document.getElementById('discountValue').value) || 0;
  
  let discountAmount = 0;
  if (dType === 'percent') {
    discountAmount = subtotal * (dValue / 100);
  } else {
    discountAmount = dValue;
  }
  
  // Prevent discount from exceeding subtotal or being negative
  discountAmount = Math.max(0, Math.min(discountAmount, subtotal));
  
  const total = subtotal - discountAmount;

  return {
    id: currentId,
    no: document.getElementById('invNo').value,
    poNo: document.getElementById('poNo').value.trim(),
    date: document.getElementById('invDate').value || todayISO(),
    customer: {
      name:   document.getElementById('cName').value.trim(),
      address:document.getElementById('cAddress').value.trim(),
      mobile: document.getElementById('cMobile').value.trim()
    },
    items,
    subtotal,
    discountType: dType,
    discountValue: dValue,
    discountAmount,
    total,
    remarks: document.getElementById('remarks').value.trim()
  };
}

