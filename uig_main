<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sakib's Invoice Generator</title>
<style>
:root {
  --ink: #0f2a43;
  --ink2: #506b85;
  --line: #d8e2ee;
  --bg: #eef2f6;
  --accent: #0a5b9e;
  --accent-d: #084a80;
  --gold: #d4a017;
  --radius: 10px;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: var(--bg);
  color: var(--ink);
  font-size: 14px;
  line-height: 1.45;
}
h1,h2,h3,h4 { margin: 0; font-weight: 750; }
button { font: inherit; cursor: pointer; border: none; border-radius: 8px; padding: 8px 14px; background: #e8edf5; color: var(--ink); transition: .15s; }
button:hover { filter: brightness(.96); }
input, select, textarea {
  font: inherit; width: 100%; padding: 8px 10px; border: 1px solid var(--line);
  border-radius: 8px; background: #fff; color: var(--ink); outline: none;
}
input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(10,91,158,.12); }
label { display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 600; color: var(--ink2); }

/* ---------- Header ---------- */
.app-header {
  position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 26px;
  padding: 0 20px; height: 58px; background: var(--ink); color: #fff;
  box-shadow: 0 2px 10px rgba(0,0,0,.12);
}
.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: .2px; }
.brand .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 3px rgba(212,160,23,.25); }
.brand small { font-weight: 500; opacity: .65; font-size: 11px; border: 1px solid rgba(255,255,255,.25); padding: 1px 7px; border-radius: 20px; }
.tabs { display: flex; gap: 4px; margin-left: auto; }
.tab { background: transparent; color: rgba(255,255,255,.7); padding: 8px 14px; border-radius: 8px; font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 7px; }
.tab:hover { background: rgba(255,255,255,.09); color: #fff; }
.tab.active { background: rgba(255,255,255,.16); color: #fff; }
.count { background: rgba(255,255,255,.22); border-radius: 20px; padding: 0 7px; font-size: 11px; min-width: 18px; text-align: center; }

/* ---------- Views ---------- */
.view { display: none; padding: 20px; }
.view.active { display: block; }
.layout { display: grid; grid-template-columns: minmax(400px, 480px) 1fr; gap: 22px; align-items: start; max-width: 1560px; margin: 0 auto; }
@media (max-width: 1100px) { .layout { grid-template-columns: 1fr; } }

.card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; margin-bottom: 14px; }
.card h3 { font-size: 12px; text-transform: uppercase; letter-spacing: .7px; color: var(--ink2); margin-bottom: 12px; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.span2 { grid-column: span 2; }

/* ---------- Items ---------- */
.items-head, .item-row {
  display: grid;
  grid-template-columns: 84px 1fr 56px 100px 98px 28px;
  gap: 6px; align-items: center;
}
.items-head {
  font-size: 10.5px; font-weight: 700; color: var(--ink2);
  text-transform: uppercase; letter-spacing: .5px;
  margin-bottom: 6px; padding: 0 2px;
}
.item-row { margin-bottom: 6px; }
.item-row input { padding: 7px 8px; font-size: 13px; }
.i-total { text-align: right; font-weight: 600; font-size: 13px; font-variant-numeric: tabular-nums; color: var(--ink); }
.i-del { background: transparent; color: #b3bccb; padding: 4px; border-radius: 6px; font-size: 17px; line-height: 1; }
.i-del:hover { background: #fdecea; color: #d93025; }

.btn.primary { background: var(--accent); color: #fff; font-weight: 600; width: 100%; padding: 11px; }
.btn.primary:hover { background: var(--accent-d); }
.btn.ghost { background: #fff; border: 1px dashed var(--line); color: var(--ink2); width: 100%; margin-top: 4px; }
.btn.sm { padding: 5px 10px; font-size: 12px; }

/* ---------- Paper (A4) ---------- */
.paper-toolbar { display: flex; gap: 8px; justify-content: flex-end; margin-bottom: 10px; max-width: 820px; margin-left: auto; margin-right: auto; }
.paper-toolbar button { background: var(--ink); color: #fff; }
.paper {
  background: #fff; width: 100%; max-width: 820px; margin: 0 auto;
  padding: 38px 44px; border-radius: 6px;
  box-shadow: 0 6px 26px rgba(15,42,67,.13);
  color: #1b2431; font-size: 13px;
}

/* --- header with logos --- */
.p-head {
  display: flex; align-items: center; gap: 18px;
  padding-bottom: 0px; border-bottom: 3px solid var(--ink);
}
.p-head-text { flex: 1; text-align: center; min-width: 0; }
.p-head-text h1 { font-size: 16px; letter-spacing: 0px; color: var(--ink); margin: 0 0 7px; }
.p-head-text p { margin: 2px 0; font-size: 12px; color: #4a5a72; }
.p-logo-slot {
  flex: none; width: 140px; height: 150px;
  display: flex; align-items: center; justify-content: center;
}
.p-logo-slot img { max-width: 140px; max-height: 150px; object-fit: contain; }
.p-logo-slot.empty { visibility: hidden; }

.p-title { font-size: 21px; font-weight: 700; text-align: center; margin: 10px 0 16px; letter-spacing: 1px; color: var(--ink); }

.p-meta { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 16px; }
.p-meta span { display: block; }
.p-meta strong { color: var(--ink); }

.p-parties { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 20px; font-size: 12px; }
.p-parties .box h4 { font-size: 10.5px; text-transform: uppercase; letter-spacing: 1.1px; color: var(--ink2); margin: 0 0 6px; }
.p-parties .box p { margin: 2px 0; line-height: 1.55; color: #34495e; }
.p-parties .box p strong { color: var(--ink); }

table.p-items { width: 100%; border-collapse: collapse; margin: 4px 0 12px; font-size: 12px; }
table.p-items thead th {
  background: var(--ink); color: #fff; padding: 8px 10px; text-align: left;
  font-weight: 600; font-size: 10.5px; letter-spacing: .6px; text-transform: uppercase;
}
table.p-items thead th.r { text-align: right; }
table.p-items thead th.c { text-align: center; width: 36px; }
table.p-items tbody td { padding: 8px 10px; border-bottom: 1px solid #edf1f7; vertical-align: top; }
table.p-items tbody td.r { text-align: right; font-variant-numeric: tabular-nums; }
table.p-items tbody td.c { text-align: center; color: var(--ink2); }
table.p-items tbody tr:nth-child(even) { background: #fafbfd; }

/* Summary Rows in Table */
table.p-items tbody tr.summary-row td { background: #f4f7fb; font-weight: 600; border-bottom: none; padding-top: 6px; padding-bottom: 6px; }
table.p-items tbody tr.discount-row td { background: #f4f7fb; font-weight: 600; border-bottom: none; color: #b3261e; padding-top: 2px; padding-bottom: 6px; }
table.p-items tbody tr.grand-total-row td { background: #f4f7fb; font-weight: 800; font-size: 14px; border-top: 2px solid var(--ink); border-bottom: none; padding-top: 10px; padding-bottom: 10px; }

.p-inword { font-size: 13px; margin: 10px 0 12px; padding: 8px 12px; background: #f4f7fb; border-left: 3px solid var(--accent); }
.p-inword strong { color: var(--ink2); font-weight: 600; }

.p-remarks {
  font-size: 12px; margin: 0 0 16px; padding: 8px 12px;
  background: #fff8e6; border-left: 3px solid var(--gold);
  color: #5a4a1f; white-space: pre-line;
}
.p-remarks strong { color: var(--ink); display: block; font-size: 10.5px; text-transform: uppercase; letter-spacing: .8px; margin-bottom: 3px; }

.p-terms { font-size: 12px; margin: 12px 0 24px; }
.p-terms h4 { font-size: 11px; text-transform: uppercase; letter-spacing: .9px; color: var(--ink); margin: 0 0 6px; }
.p-terms ul { margin: 0; padding-left: 18px; color: #34495e; }
.p-terms li { margin: 2px 0; line-height: 1.6; }

.p-sign { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; margin-top: 40px; }
.p-sign .sig { border-top: 1px solid #9aa8bb; padding-top: 6px; font-size: 12px; color: var(--ink2); }
.p-sign .sig strong { display: block; color: var(--ink); font-size: 11px; margin-bottom: 4px; text-transform: uppercase; letter-spacing: .9px; }
.p-sign .sig p { margin: 2px 0; }

/* --- Footer Logos --- */
.p-footer {
  margin-top: 40px;
  padding-top: 15px;
  border-top: 1px dashed var(--line);
  text-align: center;
  page-break-inside: avoid;
}
.p-footer img {
  max-width: 100%;
  max-height: 80px;
  object-fit: contain;
}

/* ---------- Tables / lists ---------- */
.panel { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; max-width: 1240px; margin: 0 auto; }
table.data { width: 100%; border-collapse: collapse; font-size: 13px; }
table.data th { text-align: left; font-size: 10.5px; text-transform: uppercase; letter-spacing: .6px; color: var(--ink2); padding: 8px 10px; border-bottom: 2px solid var(--line); }
table.data td { padding: 9px 10px; border-bottom: 1px solid #f1f4f9; }
table.data td.num { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
table.data tr:hover td { background: #fafbfd; }
.empty { text-align: center; color: #9aa8bb; padding: 34px 0 !important; }
.badge { font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 20px; white-space: nowrap; }
.actions { display: flex; gap: 5px; justify-content: flex-end; }
.actions button { background: #eef2f8; font-size: 12px; padding: 5px 10px; }
.actions button[data-act="del"]:hover, .actions button[data-del]:hover { background: #fdecea; color: #d93025; }
code { background: #eef2f8; padding: 1px 6px; border-radius: 4px; font-size: 12px; color: var(--accent); }

/* ---------- Logo settings ---------- */
.logo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.logo-box {
  border: 1px dashed var(--line); border-radius: 8px; padding: 12px;
  display: flex; flex-direction: column; gap: 8px;
}
.logo-box-head { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 600; color: var(--ink2); }
.logo-preview-wrap {
  height: 90px; background: #f7f9fc; border-radius: 6px;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.logo-preview-wrap img { max-width: 100%; max-height: 86px; object-fit: contain; }
.logo-preview-wrap .ph { color: #b3bccb; font-size: 11px; }
.logo-box input[type=file] { font-size: 11px; padding: 5px 8px; }
.logo-box button { font-size: 11px; padding: 4px 9px; background: #fdecea; color: #b3261e; align-self: flex-start; }

/* ---------- Toast ---------- */
.toast {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(20px);
  background: var(--ink); color: #fff; padding: 11px 20px; border-radius: 10px; font-weight: 600;
  box-shadow: 0 8px 26px rgba(0,0,0,.25); opacity: 0; pointer-events: none; transition: .25s; z-index: 100;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ---------- Print ---------- */
@media print {
  @page { size: A4; margin: 12mm; }
  body { background: #fff; }
  .app-header, .form-panel, .paper-toolbar, .toast, .no-print { display: none !important; }
  .view { display: none !important; padding: 0; }
  #view-new { display: block !important; }
  .layout { display: block; max-width: none; }
  .paper { box-shadow: none; padding: 0; max-width: none; width: 100%; }
  .p-logo-slot img { max-height: 70px; }
  table.p-items tbody tr { page-break-inside: avoid; }
  .p-sign { page-break-inside: avoid; }
  .p-footer { page-break-inside: avoid; }
}
</style>
</head>
<body>

<header class="app-header">
  <div class="brand"><span class="dot"></span> Make your invoice <small>BDT ৳</small></div>
  <nav class="tabs" id="tabs">
    <button class="tab active" data-view="new">New Invoice</button>
    <button class="tab" data-view="history">History <span class="count" id="histCount">0</span></button>
    <button class="tab" data-view="products">Stock <span class="count" id="prodCount">0</span></button>
    <button class="tab" data-view="settings">Settings</button>
  </nav>
</header>

<main>

  <!-- ============ NEW INVOICE ============ -->
  <section id="view-new" class="view active">
    <div class="layout">

      <!-- FORM -->
      <div class="form-panel">
        <div class="card">
          <h3>Invoice details</h3>
          <div class="grid2">
            <label>Date <input id="invDate" type="date"></label>
            <label>PO No. <input id="poNo" placeholder="DRIS/PO/2026/001"></label>
            <label>Internal Ref <input id="invNo" readonly style="background:#f5f7fa"></label>
          </div>
        </div>

        <div class="card">
          <h3>Customer / To</h3>
          <div class="grid2">
            <label class="span2">Customer Name <input id="cName"></label>
            <label class="span2">Address <input id="cAddress"></label>
            <label class="span2">Mobile No <input id="cMobile"></label>
          </div>
        </div>

        <div class="card">
          <h3>Items</h3>
          <div class="items-head">
            <span>Code</span>
            <span>Product Name</span>
            <span>Qty</span>
            <span>Unit Price</span>
            <span style="text-align:right">Total</span>
            <span></span>
          </div>
          <div id="items"></div>
          <button id="btnAddItem" class="btn ghost">+ Add item</button>
        </div>

        <div class="card">
          <h3>Discount</h3>
          <div class="grid2">
            <label>Discount Type
              <select id="discountType">
                <option value="flat">Flat Amount (৳)</option>
                <option value="percent">Percentage (%)</option>
              </select>
            </label>
            <label>Discount Value <input id="discountValue" type="number" min="0" step="any" value="0"></label>
          </div>
        </div>

        <div class="card">
          <h3>Remarks</h3>
          <label class="span2" style="gap:5px">
            Additional remarks / special instructions (optional)
            <textarea id="remarks" rows="2" placeholder="e.g. Delivery to site on 16/10/2026 before 5 PM"></textarea>
          </label>
        </div>

        <button id="btnSave" class="btn primary">Save Invoice</button>
      </div>

      <!-- PREVIEW -->
      <div class="preview-panel">
        <div class="paper-toolbar no-print">
          <button id="btnPrint">🖨 Print / Save as PDF</button>
          <button id="btnNew">＋ New Blank</button>
        </div>
        <div class="paper" id="paper"></div>
      </div>

    </div>
  </section>

  <!-- ============ HISTORY ============ -->
  <section id="view-history" class="view">
    <div class="panel">
      <table class="data">
        <thead>
          <tr>
            <th>Ref</th><th>Date</th><th>PO No.</th><th>Customer</th>
            <th style="text-align:right">Total</th><th style="text-align:right">Actions</th>
          </tr>
        </thead>
        <tbody id="historyBody"></tbody>
      </table>
    </div>
  </section>

  <!-- ============ PRODUCTS ============ -->
  <section id="view-products" class="view">
    <div class="panel" style="margin-bottom:14px">
      <h3 style="font-size:12px;text-transform:uppercase;letter-spacing:.7px;color:var(--ink2);margin-bottom:10px">Add product</h3>
      <div style="display:grid;grid-template-columns:1.3fr 1fr 1fr 110px 110px auto;gap:10px;align-items:end">
        <label>Name <input id="npName" placeholder="Product name"></label>
        <label>Category <input id="npCat" placeholder="Robot / Kit / Equipment"></label>
        <label>Unit <input id="npUnit" placeholder="pcs" value="pcs"></label>
        <label>Price ৳ <input id="npPrice" type="number" min="0" step="any" value="0"></label>
        <label>Code <input id="npCode" placeholder="auto" style="background:#f5f7fa"></label>
        <button id="btnAddProduct" class="btn sm" style="background:var(--accent);color:#fff;height:38px">Add</button>
      </div>
    </div>

    <div class="panel" style="margin-bottom:14px">
      <h3 style="font-size:12px;text-transform:uppercase;letter-spacing:.7px;color:var(--ink2);margin-bottom:8px">Bulk import</h3>
      <p style="color:var(--ink2);font-size:12px;margin:0 0 10px">
        One product per line — <code>Name | Category | Price | Unit</code>. Codes are auto-generated as <code>PREFIX-001</code>.
      </p>
      <textarea id="bulkText" rows="4" placeholder="Cadebot Delivery Robot | Robot | 0 | pcs&#10;Ugot Basic Kit | Kit | 0 | pcs"></textarea>
      <div style="display:flex;gap:8px;margin-top:10px">
        <button id="btnBulk" class="btn sm" style="background:var(--accent);color:#fff">Import products</button>
        <button id="btnClearProducts" class="btn sm">Clear all products</button>
      </div>
    </div>

    <div class="panel">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:12px">
        <input id="prodSearch" placeholder="Search products by name, code or category…" style="max-width:420px">
        <span style="color:var(--ink2);font-size:12px">Click <strong>Add to invoice</strong> to append a product to the current invoice.</span>
      </div>
      <table class="data">
        <thead><tr><th>Code</th><th>Product Name</th><th>Category</th><th>Unit</th><th style="text-align:right">Default Price</th><th style="text-align:right">Action</th></tr></thead>
        <tbody id="productsBody"></tbody>
      </table>
    </div>
  </section>

  <!-- ============ SETTINGS ============ -->
  <section id="view-settings" class="view">
    <div class="panel">
      <h3 style="font-size:12px;text-transform:uppercase;letter-spacing:.7px;color:var(--ink2);margin-bottom:12px">Logos (shown in invoice header & footer)</h3>
      <div class="logo-grid" style="margin-bottom:22px">
        <div class="logo-box">
          <div class="logo-box-head">
            <span>Left logo (main company)</span>
            <button type="button" id="btnRemoveLogo1">Remove</button>
          </div>
          <div class="logo-preview-wrap" id="logo1Preview"><span class="ph">No logo</span></div>
          <input type="file" id="logo1File" accept="image/*">
        </div>
        <div class="logo-box">
          <div class="logo-box-head">
            <span>Right logo (partner / sister concern)</span>
            <button type="button" id="btnRemoveLogo2">Remove</button>
          </div>
          <div class="logo-preview-wrap" id="logo2Preview"><span class="ph">No logo</span></div>
          <input type="file" id="logo2File" accept="image/*">
        </div>
      </div>
      
      <!-- Footer Logo Box -->
      <div class="logo-box" style="margin-bottom:22px;">
        <div class="logo-box-head">
          <span>Footer Logos (Partner Strip)</span>
          <button type="button" id="btnRemoveLogoFooter">Remove</button>
        </div>
        <div class="logo-preview-wrap" id="logoFooterPreview" style="height: 80px;"><span class="ph">No footer logos</span></div>
        <input type="file" id="logoFooterFile" accept="image/*">
        <span style="font-size: 11px; color: #506b85; margin-top: 4px;">Upload the strip of partner logos (HANS LASER, ABB, etc.) to display at the bottom of the invoice.</span>
      </div>

      <h3 style="font-size:12px;text-transform:uppercase;letter-spacing:.7px;color:var(--ink2);margin-bottom:12px">Company header (printed on invoice)</h3>
      <div class="grid2">
        <label class="span2">Company name <input id="sName"></label>
        <label class="span2">Address line <input id="sAddress"></label>
        <label>Email <input id="sEmail"></label>
        <label>Phone <input id="sPhone"></label>
        <label class="span2">Websites (use | between) <input id="sWeb"></label>
      </div>

      <h3 style="font-size:12px;text-transform:uppercase;letter-spacing:.7px;color:var(--ink2);margin:22px 0 12px">From / Seller details</h3>
      <div class="grid2">
        <label class="span2">From company <input id="sFrom"></label>
        <label class="span2">From address <input id="sFromAddr"></label>
        <label>Seller name <input id="sSeller"></label>
        <label>Seller phone <input id="sSellerPhone"></label>
      </div>

      <h3 style="font-size:12px;text-transform:uppercase;letter-spacing:.7px;color:var(--ink2);margin:22px 0 12px">Terms &amp; Conditions</h3>
      <label class="span2" style="margin-bottom:10px">One term per line (rendered as bullet points)
        <textarea id="sTerms" rows="6"></textarea>
      </label>

      <h3 style="font-size:12px;text-transform:uppercase;letter-spacing:.7px;color:var(--ink2);margin:22px 0 12px">Numbering</h3>
      <div class="grid2">
        <label>Invoice prefix <input id="sPrefix" placeholder="INV"></label>
        <label>Next invoice number <input id="sNextNo" type="number" min="1"></label>
        <label>PO prefix <input id="sPoPrefix" placeholder="DRIS/PO"></label>
      </div>

      <div style="display:flex;gap:8px;margin-top:18px;flex-wrap:wrap">
        <button id="btnSaveSettings" class="btn" style="background:var(--accent);color:#fff">Save settings</button>
        <button id="btnResetStock" class="btn sm">Restore default stock list</button>
        <button id="btnExport" class="btn sm">Export backup (.json)</button>
        <button id="btnImport" class="btn sm">Import backup</button>
        <input id="importFile" type="file" accept="application/json" hidden>
      </div>
    </div>
  </section>

</main>

<datalist id="productList"></datalist>
<div class="toast" id="toast"></div>

<script>
/* =========================================================
   Daffodil Robotics — Invoice Generator
   Single-file browser app. Storage: localStorage.
   ========================================================= */

const STORAGE_KEY = 'daffodil_invoicegen_v2';

/* ---------- helpers ---------- */
const esc = s => String(s ?? '').replace(/[&<>"']/g, c =>
  ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
const nf = new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const money = n => nf.format(Number(n) || 0);
const moneySym = n => '৳' + nf.format(Number(n) || 0);
const fmtQty = q => Number(q || 0).toLocaleString('en-IN', { maximumFractionDigits: 2 });
const todayISO = () => new Date().toISOString().slice(0, 10);
const uid = () => 'inv_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);

/* ---------- amount in words (BD lakh/crore) ---------- */
const ONES = ['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve',
  'Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
const TENS = ['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
function two(n){ return n < 20 ? ONES[n] : TENS[Math.floor(n/10)] + (n % 10 ? ' ' + ONES[n % 10] : ''); }
function three(n){
  const h = Math.floor(n/100), r = n % 100;
  let out = h ? ONES[h] + ' Hundred' : '';
  if (r) out += (out ? ' ' : '') + two(r);
  return out;
}
function intToWords(n){
  if (n === 0) return 'Zero';
  const parts = [];
  const crore = Math.floor(n / 10000000); n %= 10000000;
  const lakh  = Math.floor(n / 100000);   n %= 100000;
  const thou  = Math.floor(n / 1000);     n %= 1000;
  if (crore) parts.push(intToWords(crore) + ' Crore');
  if (lakh)  parts.push(two(lakh) + ' Lakh');
  if (thou)  parts.push(two(thou) + ' Thousand');
  if (n)     parts.push(three(n));
  return parts.join(' ');
}
function amountInWords(amount){
  const neg = amount < 0;
  amount = Math.abs(amount);
  let taka = Math.floor(amount + 1e-9);
  let paisa = Math.round((amount - taka) * 100);
  if (paisa === 100) { taka++; paisa = 0; }
  let out = intToWords(taka) + ' Taka';
  if (paisa) out += ' and ' + two(paisa) + ' Paisa';
  return (neg ? 'Minus ' : '') + out + ' only';
}

