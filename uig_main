const CATEGORY_PREFIX = { Robot: 'ROB', Kit: 'KIT', Equipment: 'EQP', Accessory: 'ACC' };

function categoryPrefix(cat){
  if (CATEGORY_PREFIX[cat]) return CATEGORY_PREFIX[cat];
  const letters = String(cat || 'GEN').replace(/[^A-Za-z]/g, '').toUpperCase();
  return (letters.slice(0, 3) || 'GEN').padEnd(3, 'X');
}

function buildSeedProducts(){
  const counters = {};
  return STOCK_SEED.map(([name, category]) => {
    const p = categoryPrefix(category);
    counters[p] = (counters[p] || 0) + 1;
    return { code: p + '-' + String(counters[p]).padStart(3, '0'), name, category, unit: 'pcs', price: 0 };
  });
}

